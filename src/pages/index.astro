---
import Icon from '../components/SideworkIcon.astro';
import PluginFooter from '../components/PluginFooter.astro';
import StudioLayout from '../components/StudioLayout.astro';
import { projects } from '../data/projects';
import { authConfiguration } from '../lib/github-auth.mjs';
import { showcaseStore } from '../lib/showcases.mjs';
import '../styles/gallery.css';
import { PROJECT_CATEGORIES } from '../scripts/project-metadata.mjs';

const { searchParams } = Astro.url;
const kind = searchParams.get('kind');
const category = searchParams.get('category');
const profileFilters = new URLSearchParams();
if (kind === 'projects' || kind === 'contributions') profileFilters.set('kind', kind);
if (kind !== 'contributions' && category && Object.hasOwn(PROJECT_CATEGORIES, category)) {
  profileFilters.set('category', category);
}
if (profileFilters.size) return Astro.redirect(`/mager/?${profileFilters}`);

const featured = projects[0];
const config = authConfiguration();
let showcases = [];
try { if (config.ready) showcases = await showcaseStore(config).explore(); }
catch { /* The committed @mager showcase is available during an account store outage. */ }
const hasMagerShowcase = showcases.some(showcase => showcase.githubId === '17733');
const gallery = [
  ...(!hasMagerShowcase ? [{ handle: '@mager', path: `/projects/${featured.id}/`, project: featured, committed: true }] : []),
  ...showcases.map(showcase => ({ ...showcase, path: `/showcase/${showcase.slug}/`, committed: false })),
];
---
<StudioLayout title="Explore · Sidework" description="Discover personal software and the people who build it." active="explore" bodyClass="studio-with-plugin-footer gallery-page">
  <header class="gallery-intro">
    <div>
      <p class="gallery-eyebrow">The personal software gallery</p>
      <h1>Made by people.<br/>Made for something.</h1>
      <p class="gallery-intro-copy">Small tools, side projects, and ideas people cared enough to build. Take a look around.</p>
    </div>
    <div class="gallery-intro-actions">
      {Astro.locals.account && <a class="sw-button sw-primary" href="/showcase/">Share your project <Icon name="arrow" size={16}/></a>}
      <a class="gallery-text-link" href="/onboarding/?view=stars">Your stars and forks <Icon name="arrow" size={16}/></a>
    </div>
  </header>

  <section class="gallery" aria-labelledby="gallery-title">
    <div class="gallery-heading"><h2 id="gallery-title">In the gallery</h2><p>Shared by their builders.</p></div>
    <ul class="gallery-grid" role="list">
      {gallery.map(({ handle, path, project, committed }, index) => <li class="gallery-item">
        <a class="gallery-media" href={path} aria-label={`Explore ${project.name} by ${handle}`}>
          {project.image
            ? <img src={project.image} alt={project.imageAlt || `Screenshot of ${project.name}`} width={project.imageWidth} height={project.imageHeight} loading={index < 2 ? 'eager' : 'lazy'} decoding="async" referrerpolicy="no-referrer"/>
            : <div class="gallery-type-preview"><span>{project.name}</span><small>Personal software by {handle}</small></div>}
        </a>
        <div class="gallery-project-copy">
          <p class="gallery-maker"><a href={committed ? '/mager/' : path}>{handle}</a></p>
          <h3><a href={path}>{project.name} <Icon name="arrow" size={18}/></a></h3>
          {(project.tagline || project.description) && <p class="gallery-purpose">{project.tagline || project.description}</p>}
          <div class="gallery-source">
            <a href={path}>{committed ? 'From the public profile' : 'View showcase'}</a>
            {project.source && <a href={project.source} rel="noreferrer">Source <Icon name="external" size={13}/></a>}
          </div>
        </div>
      </li>)}
    </ul>
  </section>
  <PluginFooter slot="footer" />
</StudioLayout>
