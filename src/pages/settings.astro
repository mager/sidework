---
import StudioLayout from '../components/StudioLayout.astro';
import ThemeControl from '../components/ThemeControl.astro';
import { adminConfiguration, isAdminOwner } from '../lib/admin.mjs';
import '../styles/settings.css';
const account = Astro.locals.account;
const admin = adminConfiguration();
---
<StudioLayout title="Settings · Sidework" active="settings">
 <div class="settings-main"><h1>Settings</h1><p class="settings-intro">Your account and browser preferences.</p>
 <section class="settings-section" aria-labelledby="appearance-title"><div><h2 id="appearance-title">Appearance</h2><p>Choose light, dark, or follow your system.</p></div><ThemeControl /><noscript><p>Enable JavaScript to change your theme.</p></noscript></section>
 <section class="settings-section" aria-labelledby="workspace-title"><div><h2 id="workspace-title">Browser workspace</h2><p>Clear browser drafts, the weekly plan, saves, and follows. Keep your access and theme.{account && ' Account drafts stay saved.'}</p><p>A restore copy stays in this browser. Each reset replaces that copy. Restoring it changes only this browser.</p></div><div class="settings-actions"><button type="button" class="sw-button" id="reset-workspace">Reset browser workspace</button><button type="button" class="sw-button" id="restore-workspace" hidden>Restore browser workspace</button></div><p id="settings-status" role="status" hidden></p><noscript><p>Enable JavaScript to reset or restore your workspace.</p></noscript></section>
 {account && <section class="settings-section" aria-labelledby="updates-title"><div><h2 id="updates-title">Email updates</h2><p>{account.email}</p></div><form action="/api/account/updates" method="POST"><label><input type="checkbox" name="updates" checked={account.email_updates}/> Email me Sidework updates.</label><button class="sw-button" type="submit">Save preference</button></form>{Astro.url.searchParams.get('saved') === '1' && <p role="status">Preference saved.</p>}{Astro.url.searchParams.has('error') && <p role="alert">Could not save. Please try again.</p>}</section>}
 <section class="settings-section" aria-labelledby="access-title"><div><h2 id="access-title">Preview access</h2><p>{account ? `Signed in as @${account.login}.` : 'Your existing preview session is active.'} Your local work stays in this browser when you sign out.</p></div><form action="/api/signout" method="POST"><button class="sw-button" type="submit">Sign out</button></form></section>
 {admin.origin && isAdminOwner(account,admin) && <section class="settings-section" aria-labelledby="admin-title"><div><h2 id="admin-title">Admin</h2><p>View signups and email preferences.</p></div><a class="sw-button" href={admin.origin}>Open admin</a></section>}
 </div>
 <script>import '../scripts/settings';</script>
</StudioLayout>
