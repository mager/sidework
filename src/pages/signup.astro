---
import AccountLayout from '../components/AccountLayout.astro';
import Icon from '../components/SideworkIcon.astro';
import { projects } from '../data/projects';
import { authConfiguration } from '../lib/github-auth.mjs';
if (Astro.locals.account) return Astro.redirect(Astro.locals.hasAccess ? '/friends/' : '/waiting/',303);
const config = authConfiguration();
const ready = config.ready && config.origin === Astro.url.origin;
const errors:Record<string,string> = {
 unavailable:'GitHub sign-in is not ready yet. Please check back soon.',
 expired:'Your sign-in expired. Please try again.',
 cancelled:'GitHub sign-in was cancelled. You can try again when you’re ready.',
 retry:'We could not complete sign-in. Please try again.',
 email:'Add a verified email to your GitHub account, then try again.',
};
const error = errors[Astro.url.searchParams.get('error') || ''] || '';
---
<AccountLayout title="Join Sidework" showcase>
 <section class="signup-copy">
  <h1>Show what<br/>you build.</h1>
  <p class="account-intro">A home for personal projects and open source contributions.</p>
  <form action="/auth/github/" method="POST" class="account-form">
   <button class="sw-button sw-primary" type="submit" disabled={!ready}><Icon name="code" size={20}/>Join with GitHub</button>
   <p class="account-note">Join the waitlist. @mager grants access personally.</p>
   <label class="account-check"><input type="checkbox" name="updates"/>Email me Sidework updates.</label>
  </form>
  {(error || !ready) && <p class="entry-error" role="status">{error || errors.unavailable}</p>}
  <p class="account-note">Already joined? The same button signs you in.<br/>We keep you signed in on this browser.</p>
 </section>
 <aside class="signup-work" aria-label="Work on Sidework">
  {projects.slice(0,3).map(project=><a class="signup-project" href="/mager/"><img src={project.image} alt="" width="112" height="76"/><span><strong>{project.name}</strong><span>{project.tagline}</span></span><Icon name="arrow" size={16}/></a>)}
  <a class="signup-explore" href="/mager/">Explore work by @mager <Icon name="arrow" size={16}/></a>
 </aside>
</AccountLayout>
