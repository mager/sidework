---
import AccountLink from '../components/AccountLink.astro';
import BaseHead from '../components/BaseHead.astro';
import Icon from '../components/SideworkIcon.astro';
import { projects } from '../data/projects';
import { opportunities } from '../data/sidework';
import '../styles/sidework.css';
import '../styles/entry.css';
const seed = JSON.stringify({ projects, opportunityIds:opportunities.map(item => item.id) }).replace(/</g,'\\u003c');
---
<!doctype html><html lang="en"><head><BaseHead title="Bring your projects · Sidework" description="Find your public GitHub repositories and choose what to bring to Sidework."/><meta name="robots" content="noindex,nofollow"/></head><body class="entry-page">
<header class="entry-header"><a href="/" class="entry-brand"><Icon name="branch" size={27}/>sidework.</a><a class="entry-header-context" href="/workbench/#projects">Your workbench <Icon name="arrow" size={18}/></a><AccountLink/></header>
<main class="import-main" id="main"><h1>You’ve already<br/>built something.</h1><p class="entry-intro">Bring it here. Find your public GitHub repositories, then choose the projects you want in your workbench.</p>
<form id="github-import-form" class="import-form"><label for="github-handle">Your GitHub handle</label><div class="import-input"><input type="text" id="github-handle" name="handle" placeholder="@handle" value={Astro.locals.account ? `@${Astro.locals.account.login}` : ''} autocomplete="off" autocapitalize="none" spellcheck="false" maxlength="40" required/><button class="sw-button sw-primary" id="find-repos" type="submit">Find my repositories <Icon name="arrow" size={18}/></button><button class="sw-button" type="button" id="cancel-import" hidden>Cancel</button></div></form>
<p class="import-status" id="import-status" role="status">Public repositories only. No GitHub sign-in or account permissions needed.</p>
<section id="repo-results" aria-label="Choose repositories" hidden><div class="repo-controls"><input type="search" id="repo-search" aria-label="Search repositories" placeholder="Find a project…"/><label><input type="checkbox" id="include-forks" checked/>Forks</label><label><input type="checkbox" id="include-archived" checked/>Archived</label><button class="sw-button" id="select-matching" type="button">Select matching</button><button class="sw-button" id="clear-selection" type="button">Clear selection</button></div><p id="repo-count" class="import-status"></p><ul class="repo-list" id="repo-list"></ul><button class="sw-button" id="show-more" type="button" hidden>Show more repositories</button><div class="import-actions"><p><span id="selection-count">0 selected</span><br/>Drafts stay in this browser until publishing is available.</p><button class="sw-button sw-primary" id="import-selected" type="button" disabled>Import selected</button></div></section>
<div id="import-result" class="import-result" role="status" hidden><p id="import-result-text"></p><a href="/workbench/#projects">Open your projects <Icon name="arrow" size={20}/></a></div>
<noscript><p class="entry-error">Enable JavaScript to find and import your GitHub repositories.</p></noscript></main>
<footer class="entry-footer"><span>Built with Astra</span><form action="/api/signout" method="POST"><button class="sw-button" type="submit">Lock Sidework</button></form></footer>
<script type="application/json" id="import-seed" set:html={seed}/><script>import '../scripts/onboarding';</script>
</body></html>
