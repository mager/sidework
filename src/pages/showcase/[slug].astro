---
import BaseHead from '../../components/BaseHead.astro';
import Icon from '../../components/SideworkIcon.astro';
import PluginFooter from '../../components/PluginFooter.astro';
import ShowcaseContent from '../../components/ShowcaseContent.astro';
import { authConfiguration } from '../../lib/github-auth.mjs';
import { showcaseStore } from '../../lib/showcases.mjs';
import { showcaseMetadata } from '../../lib/showcase-metadata.mjs';
import { showcaseImageResponse } from '../../lib/showcase-image.mjs';
import '../../styles/sidework.css';
import '../../styles/studio.css';
import '../../styles/showcase.css';

let content;
let unavailable = false;
const slug = Astro.params.slug;
if (slug) {
  try {
    content = await showcaseStore(authConfiguration()).publicBySlug(slug);
  } catch {
    unavailable = true;
  }
}
if (!content) Astro.response.status = unavailable ? 503 : 404;
if (Astro.url.searchParams.get('image') === 'share') {
  if (!content) return new Response(unavailable ? 'Showcase unavailable' : 'Showcase not found', {
    status: unavailable ? 503 : 404, headers: { 'Cache-Control': 'no-store', 'Content-Type': 'text/plain; charset=utf-8' },
  });
  return showcaseImageResponse(content, Astro.request.method);
}
const title = content ? `${content.project.name} by ${content.handle}` : unavailable ? 'Showcase unavailable' : 'Showcase not found';
const description = content?.project.tagline || content?.project.description || 'Discover personal software on Sidework.';
const metadata = showcaseMetadata(content, slug, Astro.url.origin);
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...(metadata || { title: `${title} · Sidework`, description, image: '/favicon.svg' })}/>
    <meta name="robots" content="noindex,nofollow"/>
  </head>
  <body class="studio showcase-public">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="studio-header showcase-public-header">
      <a href="/" class="studio-wordmark" aria-label="Sidework home"><Icon name="branch" size={23}/>sidework<span>.</span></a>
      <a class="showcase-browse" href="/mager/">Browse the gallery <Icon name="arrow" size={16}/></a>
    </header>
    <main id="main" class="studio-main showcase-public-main">
      {content
        ? <ShowcaseContent content={content}/>
        : <div class="showcase-manager-heading">
          <h1>{title}</h1>
          <p>{unavailable ? 'Sidework could not load this showcase. Try again in a moment.' : 'This showcase is unavailable. Check the link with the person who shared it.'}</p>
        </div>}
    </main>
    <PluginFooter/>
  </body>
</html>
