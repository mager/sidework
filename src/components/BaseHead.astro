---
import '../styles/fonts.css';
import themeScript from '../scripts/theme.js?raw';
interface Props { title: string; description: string; image?: string; }
const {title, description, image = '/images/mager.jpg'} = Astro.props;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
{Astro.locals.account && <meta name="sidework-account" content={Astro.locals.account.github_id}/>}
{Astro.locals.account && <meta name="sidework-handle" content={`@${Astro.locals.account.login}`}/>}
<title>{title}</title>
<meta name="description" content={description} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="preload" href="/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/anybody-latin.woff2" as="font" type="font/woff2" crossorigin />
<script is:inline set:html={themeScript} />
